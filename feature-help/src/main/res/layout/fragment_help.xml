<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/zameen_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/zameen_gutter"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="136dp">

            <com.agroshift.core.ui.PhotoView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:photo="@drawable/photo_banner_help"
                app:photoRadius="@dimen/zameen_radius_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/nav_community"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/help_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="84dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/help_ask"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_ask_body"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/help_crops"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textSize="19sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/help_crops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/help_contacts"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textSize="19sp" />

        <LinearLayout
            android:id="@+id/help_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/help_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|start"
            android:minHeight="48dp"
            android:text="@string/photo_credits"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
