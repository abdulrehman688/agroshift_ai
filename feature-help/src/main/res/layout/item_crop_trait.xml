<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/trait_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/zameen_accent" />

    <TextView
        android:id="@+id/trait_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="4"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
        android:textColor="@color/zameen_text" />

    <com.agroshift.core.ui.SplitBarView
        android:id="@+id/trait_bar"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_weight="4" />

    <TextView
        android:id="@+id/trait_value"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
</LinearLayout>
