<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/zameen_gutter"
        android:paddingEnd="@dimen/zameen_gutter"
        android:paddingBottom="@dimen/zameen_gutter">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tint="@color/zameen_hairline" />

        <TextView
            android:id="@+id/guide_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Headline"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/guide_season"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textColor="@color/zameen_text_secondary" />

        <LinearLayout
            android:id="@+id/guide_stage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_crop_card"
            android:orientation="vertical"
            android:padding="8dp">

            <com.agroshift.core.ui.LivingPhotoView
                android:id="@+id/guide_growth"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:photoRadius="@dimen/zameen_radius_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/guide_month"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.AgroShift.Body"
                        android:textColor="@color/zameen_accent"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/guide_stage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.AgroShift.Body" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/guide_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/guide_slider"
                app:thumbColor="@color/zameen_text"
                app:tickVisible="true"
                app:trackColorActive="@color/zameen_accent"
                app:trackColorInactive="@color/zameen_hairline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_slider"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/guide_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_ui_drop"
            android:drawablePadding="8dp"
            android:drawableTint="@color/zameen_canal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body" />

        <LinearLayout
            android:id="@+id/guide_traits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/guide_facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textColor="@color/zameen_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/guide_note"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
