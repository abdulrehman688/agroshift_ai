<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/advisor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/zameen_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/zameen_gutter"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="136dp">

            <com.agroshift.core.ui.PhotoView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:photo="@drawable/photo_banner_advisor"
                app:photoRadius="@dimen/zameen_radius_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="@string/nav_advisor"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/advisor_fields_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/advisor_fields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/advisor_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advisor_empty_title"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advisor_add"
                style="@style/Widget.AgroShift.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/action_add_field" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advisor_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advisor_loading"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/advisor_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                app:indicatorColor="@color/zameen_accent"
                app:trackColor="@color/zameen_hairline"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <com.agroshift.core.ui.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advisor_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/advisor_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advisor_retry"
                style="@style/Widget.AgroShift.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/action_retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advisor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/advisor_stale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/advisor_stale"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/advisor_priorities"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="19sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/advisor_priorities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="false" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/advisor_best_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/advisor_best_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/plan_best"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                        android:textColor="@color/zameen_accent" />

                    <TextView
                        android:id="@+id/advisor_best_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.AgroShift.Headline"
                        android:textColor="@color/zameen_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/advisor_best_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Headline" />

                <TextView
                    android:id="@+id/advisor_best_crops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body" />

                <TextView
                    android:id="@+id/advisor_best_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/whatif_title"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="19sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/advisor_whatif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/advisor_whatif_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/plan_options"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="19sp" />

            <LinearLayout
                android:id="@+id/advisor_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/advisor_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/advisor_chart_title"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body" />

                <TextView
                    android:id="@+id/advisor_year_rain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

                <com.agroshift.core.ui.MonthlyChartView
                    android:id="@+id/advisor_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/advisor_chart_description" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/zameen_canal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/chart_rain"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/zameen_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/chart_demand"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/advisor_alerts"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="@string/advisor_alert_note"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

            <LinearLayout
                android:id="@+id/advisor_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/advisor_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/advisor_disclaimer"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
