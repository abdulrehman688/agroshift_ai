<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/zameen_gap"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/option_showing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/option_showing"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
        android:textColor="@color/zameen_accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/option_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/option_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.AgroShift.Headline"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/option_fit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

    <TextView
        android:id="@+id/option_crops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

    <TextView
        android:id="@+id/option_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

    <LinearLayout
        android:id="@+id/option_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
