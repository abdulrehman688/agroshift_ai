<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="440dp">

            <com.agroshift.core.ui.PhotoView
                android:id="@+id/home_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/home_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/zameen_gutter"
                android:paddingEnd="@dimen/zameen_gutter">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textAlignment="viewStart"
                    android:textColor="@color/zameen_text"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/home_language"
                    android:layout_width="@dimen/zameen_touch"
                    android:layout_height="@dimen/zameen_touch"
                    android:layout_marginEnd="@dimen/zameen_gap"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/command_language"
                    android:src="@drawable/ic_home_language" />

                <ImageButton
                    android:id="@+id/home_command"
                    android:layout_width="@dimen/zameen_touch"
                    android:layout_height="@dimen/zameen_touch"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_search"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="@dimen/zameen_gutter"
                android:paddingEnd="@dimen/zameen_gutter">

                <TextView
                    android:id="@+id/home_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                    android:textColor="@color/zameen_accent" />

                <TextView
                    android:id="@+id/home_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:breakStrategy="balanced"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Headline"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/home_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body"
                    android:textColor="@color/zameen_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_primary"
                    style="@style/Widget.AgroShift.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/zameen_gutter"
            android:paddingEnd="@dimen/zameen_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/season_rabi"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/season_kharif"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
            </LinearLayout>

            <com.agroshift.core.ui.SeasonThreadView
                android:id="@+id/home_season_thread"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="4dp" />

            <com.agroshift.core.ui.SkeletonView
                android:id="@+id/home_skeleton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_weather_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/home_weather_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/home_weather_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/zameen_gap"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/home_rain_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/home_rain_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.AgroShift.Body"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_rain"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_heat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/zameen_gap"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/home_heat_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.AgroShift.Body"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_heat"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_risk_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/zameen_gap"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/home_risk_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.AgroShift.Body"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_risks"
                        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_watch_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/zameen_gap"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_watch"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                    android:textColor="@color/zameen_accent" />

                <TextView
                    android:id="@+id/home_watch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/zameen_gap"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_map_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_section_field"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body"
                    android:textSize="20sp" />

                <FrameLayout
                    android:id="@+id/home_map_card"
                    android:layout_width="match_parent"
                    android:layout_height="240dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/home_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <View
                        android:id="@+id/home_map_open"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/home_section_field"
                        android:focusable="true" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/home_section_quick"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/home_tile_plan"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/home_tile_ask"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="@dimen/zameen_gap"
                android:orientation="horizontal">

                <include
                    android:id="@+id/home_tile_farm"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/home_tile_market"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
