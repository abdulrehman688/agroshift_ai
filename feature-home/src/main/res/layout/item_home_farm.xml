<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="216dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/zameen_gap"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="136dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/farm_selected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/farm_showing"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
        android:textColor="@color/zameen_accent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/farm_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textDirection="firstStrong"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/farm_crops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

    <TextView
        android:id="@+id/farm_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
        android:textColor="@color/zameen_text" />

    <TextView
        android:id="@+id/farm_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Caption"
        android:textColor="@color/zameen_canal" />
</LinearLayout>
