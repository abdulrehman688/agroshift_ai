<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background">

    <com.agroshift.core.ui.LivingPhotoView
        android:id="@+id/onboarding_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="230dp"
        app:photoScrim="true" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboarding_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/onboarding_skip"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:minHeight="48dp"
        android:text="@string/bi_skip"
        android:textAllCaps="false"
        android:textColor="@color/zameen_text"
        app:backgroundTint="@color/zameen_background" />

    <LinearLayout
        android:id="@+id/onboarding_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/zameen_gutter"
        android:paddingEnd="@dimen/zameen_gutter"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/onboarding_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_next"
            style="@style/Widget.AgroShift.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bi_next" />
    </LinearLayout>
</FrameLayout>
