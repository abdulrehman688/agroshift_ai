<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="232dp">

        <com.agroshift.core.ui.LivingPhotoView
            android:id="@+id/language_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:photoScrim="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/zameen_gutter"
            android:paddingEnd="@dimen/zameen_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layoutDirection="rtl"
                android:letterSpacing="0"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/bi_language_ur"
                android:textAlignment="viewStart"
                android:textColor="@color/zameen_text"
                android:textDirection="rtl"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layoutDirection="ltr"
                android:text="@string/bi_language_en"
                android:textAlignment="viewStart"
                android:textColor="@color/zameen_text"
                android:textDirection="ltr"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/zameen_gutter"
        android:paddingEnd="@dimen/zameen_gutter">

        <LinearLayout
            android:id="@+id/language_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/language_continue"
        style="@style/Widget.AgroShift.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/zameen_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/zameen_gutter"
        android:layout_marginBottom="16dp"
        android:text="@string/bi_continue" />
</LinearLayout>
