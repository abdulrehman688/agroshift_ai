<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/zameen_gutter"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/zameen_gutter">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="136dp">

        <com.agroshift.core.ui.PhotoView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:photo="@drawable/photo_banner_farm"
            app:photoRadius="@dimen/zameen_radius_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/home_fields_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Headline" />
    </FrameLayout>

    <TextView
        android:id="@+id/farm_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_empty_body"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textColor="@color/zameen_text_secondary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/farm_add"
        style="@style/Widget.AgroShift.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_add_field" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/farm_fields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
