<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zameen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/zameen_gutter"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/zameen_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/detail_back"
            android:layout_width="@dimen/zameen_touch"
            android:layout_height="@dimen/zameen_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_setup_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline"
                android:textDirection="firstStrong"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/detail_crops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_money_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/detail_money_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Caption"
            android:textColor="@color/zameen_accent" />

        <TextView
            android:id="@+id/detail_money"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Headline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_spent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

            <TextView
                android:id="@+id/detail_earned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewEnd"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_add_task"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/record_task"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_add_cost"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/record_cost"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_add_sale"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/record_sale"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_add_note"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@string/record_note"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/field_empty"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textColor="@color/zameen_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detail_records"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detail_plan"
        style="@style/Widget.AgroShift.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/field_view_plan" />
</LinearLayout>
