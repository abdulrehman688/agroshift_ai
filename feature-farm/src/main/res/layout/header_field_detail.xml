<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/detail_money_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_money"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/detail_money_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_money"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFeatureSettings="tnum"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Headline"
            android:textSize="32sp" />

        <com.agroshift.core.ui.SplitBarView
            android:id="@+id/detail_money_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_earned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_text" />

            <TextView
                android:id="@+id/detail_spent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAlignment="viewEnd"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/detail_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_drop"
            app:tint="@color/zameen_canal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/water_plan"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_chevron"
            app:tint="@color/zameen_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_task_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/detail_task_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFeatureSettings="tnum"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body" />

        <com.agroshift.core.ui.SplitBarView
            android:id="@+id/detail_task_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/detail_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/detail_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/field_empty"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textColor="@color/zameen_text_secondary"
        android:visibility="gone" />
</LinearLayout>
