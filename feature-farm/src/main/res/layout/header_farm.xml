<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="168dp">

        <com.agroshift.core.ui.PhotoView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:photo="@drawable/photo_banner_farm"
            app:photoRadius="@dimen/zameen_radius_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_fields_title"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline" />

            <TextView
                android:id="@+id/farm_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_text" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/farm_card_acres"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_field"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/farm_stat_acres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/farm_total_acres"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/farm_card_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/zameen_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_task"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/farm_stat_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/farm_open_tasks"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/farm_card_profit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/zameen_gap"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_money"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/farm_stat_profit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/zameen_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/farm_net"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/farm_add"
        style="@style/Widget.AgroShift.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_add_field"
        app:icon="@drawable/ic_ui_plus"
        app:iconGravity="textStart"
        app:iconTint="@color/zameen_on_accent" />

    <TextView
        android:id="@+id/farm_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/home_empty_body"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textColor="@color/zameen_text_secondary"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />
</LinearLayout>
