<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/zameen_gutter"
    android:paddingEnd="@dimen/zameen_gutter">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="@color/zameen_hairline" />

    <LinearLayout
        android:id="@+id/command_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_search"
            app:tint="@color/zameen_accent" />

        <EditText
            android:id="@+id/command_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="60"
            android:minHeight="48dp"
            android:textAlignment="viewStart"
            android:textColor="@color/zameen_text"
            android:textColorHint="@color/zameen_text_secondary"
            android:textDirection="firstStrong"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/command_clear"
            android:layout_width="@dimen/zameen_touch"
            android:layout_height="@dimen/zameen_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear"
            android:src="@drawable/ic_ui_close"
            android:visibility="gone"
            app:tint="@color/zameen_text_secondary" />

        <ImageButton
            android:id="@+id/command_voice"
            android:layout_width="@dimen/zameen_touch"
            android:layout_height="@dimen/zameen_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_voice"
            android:src="@drawable/ic_ui_mic"
            app:tint="@color/zameen_accent" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/command_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/command_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/zameen_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/command_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/command_recent_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextAppearance.AgroShift.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/search_recent"
                        android:textAlignment="viewStart" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/command_recent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/search_quick"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body"
                    android:textSize="19sp" />

                <LinearLayout
                    android:id="@+id/command_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/command_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/command_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_search"
                    app:tint="@color/zameen_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/command_empty"
                    android:textAppearance="@style/TextAppearance.AgroShift.Body"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/search_empty_hint"
                    android:textAppearance="@style/TextAppearance.AgroShift.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/command_ask"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="@string/search_ask"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
