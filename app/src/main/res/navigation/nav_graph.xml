    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.agroshift.feature.account.LanguageFragment" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.agroshift.feature.account.OnboardingFragment" />

    <fragment
        android:id="@+id/fieldSetupFragment"
        android:name="com.agroshift.feature.farm.FieldSetupFragment" />

    <fragment
