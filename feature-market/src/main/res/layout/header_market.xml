<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="168dp">

        <com.agroshift.core.ui.PhotoView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:photo="@drawable/photo_banner_market"
            app:photoRadius="@dimen/zameen_radius_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/market_earned_total"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption"
                android:textColor="@color/zameen_text" />

            <TextView
                android:id="@+id/market_earned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Headline"
                android:textSize="32sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/market_prices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_trend"
            app:tint="@color/zameen_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/market_prices"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/market_prices_body"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_external"
            app:tint="@color/zameen_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/market_card_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_sale"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/market_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/market_sales_count"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/market_card_top"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/zameen_gap"
            android:layout_weight="2"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_star"
                app:tint="@color/zameen_accent" />

            <TextView
                android:id="@+id/market_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Body"
                android:textDirection="firstStrong"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/market_top_sale"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AgroShift.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/market_chart_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zameen_gap"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/market_chart_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Body"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/market_chart_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFeatureSettings="tnum"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AgroShift.Caption"
            android:textColor="@color/zameen_accent" />

        <com.agroshift.core.ui.SalesBarsView
            android:id="@+id/market_chart"
            android:layout_width="match_parent"
            android:layout_height="132dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/market_sales"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/market_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/market_empty"
        android:textAppearance="@style/TextAppearance.AgroShift.Body"
        android:textColor="@color/zameen_text_secondary"
        android:visibility="gone" />
</LinearLayout>
